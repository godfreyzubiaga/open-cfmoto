<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_screen"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ride"
            android:tint="@color/brand_orange" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenCfMoto"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/brand_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="v1.0.21" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More"
            android:padding="10dp"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_screen"
        android:paddingBottom="@dimen/space_screen">

        <!-- Hero status card: the one thing a rider glances at. Tap to manage bikes. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_card"
            style="@style/Card.OpenCfMoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_status_circle"
                        android:contentDescription="Connection status"
                        android:padding="16dp"
                        android:src="@drawable/ic_ride"
                        android:tint="@color/status_idle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/status_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ready"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bike_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No bike paired yet"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/status_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/brand_orange"
                    android:visibility="gone" />

                <!-- Connect-sequence stepper (wired in code; hidden until connecting). -->
                <LinearLayout
                    android:id="@+id/status_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/step_dot_1"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@color/surface_high" />

                    <View
                        android:id="@+id/step_dot_2"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@color/surface_high" />

                    <View
                        android:id="@+id/step_dot_3"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@color/surface_high" />

                    <View
                        android:id="@+id/step_dot_4"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@color/surface_high" />

                    <View
                        android:id="@+id/step_dot_5"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@color/surface_high" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect"
            style="@style/Widget.OpenCfMoto.Button.Connect"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Connect" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hud_view"
            style="@style/Widget.OpenCfMoto.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Dash view — watch &amp; control"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_controls"
                style="@style/Widget.OpenCfMoto.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Controls"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_aa_stop"
                style="@style/Widget.OpenCfMoto.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Stop"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Spacer pushes the (usually hidden) log panel down; keeps the home airy. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Collapsible diagnostics: hidden by default, toggled from the More sheet. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/log_panel"
            style="@style/Card.OpenCfMoto.Log"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="3"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Diagnostics"
                        android:textColor="@color/text_secondary"
                        android:textAllCaps="true"
                        android:textSize="12sp"
                        android:letterSpacing="0.08" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_log"
                        style="@style/Widget.OpenCfMoto.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="Share" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear"
                        style="@style/Widget.OpenCfMoto.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="Clear" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_hide_log"
                        style="@style/Widget.OpenCfMoto.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="Hide" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:background="@color/bg"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/log_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="Logs"
                        android:fontFamily="monospace"
                        android:textColor="#9CDCFE"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
