<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@color/surface_high" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_aa_start"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Scan a bike" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mirror_start"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Mirror whole screen" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_devices"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Garage" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_trip"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Trips" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_setup"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_log"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Diagnostics &amp; logs" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_check_update"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Check for update" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_problem_report"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Report a problem" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_about_page"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="About &amp; credits" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_donate"
            style="@style/Widget.OpenCfMoto.SheetItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Donate" />
    </LinearLayout>
</ScrollView>
