<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand: CFMOTO Racing cyan. Bright cyan is too light for white text to sit on legibly, so
         on-accent text/icons use a deep ink ([on_brand]); the cyan itself pops as an accent on the
         dark cockpit surfaces (icons, active segments, progress, stepper). -->
    <color name="brand_accent">#14B4E6</color>
    <color name="brand_accent_dark">#0E93BE</color>
    <color name="accent_muted">#0C2A34</color>
    <color name="on_brand">#04232E</color>

    <!-- Dark "cockpit" surfaces — deeper background, clearer surface separation. -->
    <color name="bg">#0B0D12</color>
    <color name="surface">#14181F</color>
    <color name="surface_high">#1C222C</color>
    <color name="surface_container">#232A36</color>
    <color name="outline">#2A313D</color>

    <!-- Text -->
    <color name="text_primary">#F3F6FB</color>
    <color name="text_secondary">#9AA6B6</color>
    <color name="on_surface_disabled">#5A6474</color>

    <!-- Status semantics -->
    <color name="status_live">#32D74B</color>
    <color name="status_busy">#FFB020</color>
    <color name="status_error">#FF5A52</color>
    <color name="status_idle">#7C8698</color>
</resources>
